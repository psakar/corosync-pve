#!/usr/bin/make -f

# see FEATURE AREAS in dpkg-buildflags(1)
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Ensure that we link against all needed libraries (cf. Policy 10.2)
export DEB_LDFLAGS_MAINT_APPEND=-Wl,-z,defs

ifneq ($(wildcard /usr/include/statgrab.h),)
enable-monitoring=--enable-monitoring
endif

ifneq ($(wildcard /usr/include/linux/watchdog.h),)
enable-watchdog=--enable-watchdog
endif

ifneq ($(wildcard /usr/include/systemd/sd-daemon.h),)
enable-systemd=--enable-systemd
endif

# The pkg.corosync.lsbservice build profile is for Devuan and other
# systemd-free Debian derivatives (see pve-common's and pve-manager's
# pkg.*.lsbservice profiles): it installs an LSB init script mirroring
# corosync.service instead of it, and no units (corosync-notifyd's init script
# is installed by both builds). To build this variant, run:
#   dpkg-buildpackage -b -us -uc -Ppkg.corosync.lsbservice
ifneq (,$(filter pkg.corosync.lsbservice,$(DEB_BUILD_PROFILES)))
LSBSERVICE = 1
endif

%:
	dh $@

# Avoid useless dependencies in the libraries
override_dh_autoreconf:
	dh_autoreconf --as-needed

# Explicit BASHPATH fixes reproducible build on merged-usr vs non-merged:
override_dh_auto_configure:
	dh_auto_configure -- \
	    BASHPATH=/bin/bash \
	    --with-initconfigdir=/etc/default \
	    --with-logdir=/var/log/corosync \
	    --enable-dbus \
	    $(enable-monitoring) \
	    $(enable-watchdog) \
	    --enable-augeas \
	    --enable-nozzle \
	    --enable-snmp \
	    --enable-xmlconf \
	    $(enable-systemd) \
	    --enable-vqsim \
	    --disable-static

override_dh_auto_build-indep:
	$(MAKE) -C man
	$(MAKE) doxygen
	find doc/api/html -name "*.md5" -print -delete

# The check target would unnecessarily build the software
override_dh_auto_test-indep:

override_dh_auto_install-indep:
	$(MAKE) -C man DESTDIR="$(CURDIR)/debian/tmp" install

override_dh_auto_install-arch:
	dh_auto_install
	rm -v debian/tmp/usr/lib/*/lib*.la
# we don't need the upstream license
	rm debian/tmp/usr/share/doc/corosync/LICENSE

execute_before_dh_gencontrol:
	debian/check_header_deps

ifdef LSBSERVICE
# installed by debian/corosync.install and debian/corosync-notifyd.install
execute_after_dh_install:
	rm -rf debian/corosync/usr/lib/systemd debian/corosync-notifyd/usr/lib/systemd

execute_after_dh_installinit:
	dh_installinit -pcorosync --name=corosync

override_dh_installsystemd:

execute_after_dh_lintian:
	install -d debian/corosync/usr/share/lintian/overrides
	cat debian/corosync.lintian-overrides.lsbservice \
	    >>debian/corosync/usr/share/lintian/overrides/corosync
	install -d debian/corosync-notifyd/usr/share/lintian/overrides
	cat debian/corosync-notifyd.lintian-overrides.lsbservice \
	    >>debian/corosync-notifyd/usr/share/lintian/overrides/corosync-notifyd
endif
